{
  "name": "personal-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.md index.html",
    "format:check": "prettier --check src scripts tests *.json *.ts *.md index.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
